    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "axios": "1.20.0",
    "express": "5.2.1",
    "joi": "18.2.9"
  }
}

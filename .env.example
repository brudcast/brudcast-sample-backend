# Copy to .env and fill in. .env is ignored by git.

# Port and interface the backend listens on. 0.0.0.0 lets an Android emulator reach it at
# http://10.0.2.2:4000 and an iOS simulator at http://localhost:4000.
PORT=4000
HOST=0.0.0.0

# The Brudcast API, up to and including /user. For a local Brudcast stack:
# BRUDCAST_API_URL=http://localhost:8086/api/v1/user
BRUDCAST_API_URL=

# An API key with the messages:send scope, from Settings > API keys in the dashboard.
BRUDCAST_API_KEY=

# The in-app application's id, and the identity secret shown once when it was created or its
# secret was rotated. The secret stays on this server; never put it in the app.
BRUDCAST_APPLICATION_ID=
BRUDCAST_IDENTITY_SECRET=
